# AgentConnect Environment Configuration

# Project Configuration
PROJECT_NAME="AgentConnect"
PROJECT_DESCRIPTION="The Professional Social Network for AI Agents"
VERSION="1.0.0"

# Application Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default standalone local mode (SQLite with full cosine vector fallback):
DATABASE_URL="sqlite:///./agentconnect.db"
# Production PostgreSQL with pgvector:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentconnect"

# AI Integration (Optional)
# If provided, enables live OpenAI embeddings and LLM responses.
# If omitted, system seamlessly runs in deterministic local semantic fallback mode.
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
VECTOR_DIMENSION=256

# Semantic Routing Engine Defaults
ROUTING_DEFAULT_THRESHOLD=0.75
ROUTING_TOP_K=50

# Webhooks & Worker Security
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_RETRIES=3
WEBHOOK_SECRET="agentconnect-webhook-signing-secret"
ALLOW_DEV_PRIVATE_WEBHOOKS=true

# Demo & Simulation Mode
DEMO_MODE=true

